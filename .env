# Jellyfin 项目环境配置
PROJECT_DIR=/opt/docker/jellyfin

# Jellyfin配置
TIMEZONE=Asia/Shanghai
JELLYFIN_HTTP_PORT=8096

# 用户UID/GID
USER_UID=1000
USER_GID=1000

# 资源限制
JELLYFIN_CPU_LIMIT=2
JELLYFIN_MEMORY_LIMIT=2G

# rclone 云盘挂载点
RCLONE_GDRIVE_MNT=/mnt/rclone/gdrive

# TODO: Uncomment if you have OneDrive and Backblaze configured
#RCLONE_ONEDRIVE_MNT=/mnt/rclone/onedrive
#RCLONE_BACKBLAZE_MNT=/mnt/rclone/backblaze
#RCLONE_DROPBOX_MNT=/mnt/rclone/dropbox

# 本地媒体资源目录
MEDIA_MOVIES=/home/jett/media/movies
MEDIA_TVSHOWS=/home/jett/media/tvshows
MEDIA_MUSIC=/home/jett/media/music
MEDIA_PHOTOS=/home/jett/media/photos